{
  "name": "@sarahcrm/voice",
  "version": "0.1.0",
  "private": true,
  "description": "AI phone receptionist for The Club (Twilio ConversationRelay + OpenAI), Express + ws.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "configure-number": "tsx scripts/configure-number.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "express": "^5.3.0",
    "openai": "^7.45.1",
    "twilio": "^6.2.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  }
}

# ── services/voice — AI phone receptionist ─────────────────────────────
# Copy to .env (git-ignored) and fill in. The service boots without the
# Twilio/OpenAI/Supabase values; /health lists what is missing and the
# webhooks that need them answer 503 with a clear message.

PORT=4200

# Public https base URL Twilio reaches this service on (ngrok locally,
# e.g. https://abcd-1234.ngrok-free.app ; Railway domain in production).
# Used to build the wss://…/relay URL and to validate X-Twilio-Signature.
VOICE_PUBLIC_URL=

# Twilio (Console → Account info). The auth token validates every webhook.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+447915919880
# Leave true. Only set false for a local fake-Twilio test harness.
VOICE_VALIDATE_SIGNATURE=true

# OpenAI
OPENAI_API_KEY=
VOICE_OPENAI_MODEL=gpt-4.1-mini
# Model for the end-of-call summary (defaults to VOICE_OPENAI_MODEL).
VOICE_SUMMARY_MODEL=

# Supabase (service role — server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Voice (ConversationRelay). ElevenLabs voice id, optionally
# "<voiceId>-<model>-<speed>_<stability>_<similarity>".
# Default Fahco4VZzobUeiPqni1S = Twilio's documented en-GB ElevenLabs default.
# Alternatives (ElevenLabs premade British voices): Xb7hH8MSUJpSbSDYk0k2 (Alice),
# JBFqnCBsd6RMkjVDRZzb (George).
VOICE_TTS_PROVIDER=ElevenLabs
VOICE_TTS_VOICE=Fahco4VZzobUeiPqni1S
VOICE_LANGUAGE=en-GB
VOICE_TRANSCRIPTION_PROVIDER=Deepgram
# Optional Deepgram model, e.g. nova-3-general (empty = Twilio default).
VOICE_SPEECH_MODEL=

# Hard limits
VOICE_MAX_CALL_SECONDS=600
VOICE_MAX_TURNS=40
VOICE_MAX_REPLY_TOKENS=200

# Supabase project (service role — server only, never ship to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated browser origins allowed for REST + Socket.IO
CHAT_ALLOWED_ORIGINS=http://localhost:3000,https://theclubgroup.co

# Optional: override the owner (Sarah). Defaults to app_settings.media_owner.profileId
CHAT_OWNER_PROFILE_ID=

# Railway injects PORT; local default 4100
PORT=4100

# Every admin gets Sarah's chat powers (groups, all chats, reports, team access). false = Sarah only.
CHAT_ADMINS_FULL_ACCESS=true
